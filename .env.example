GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
PORT=3000
DISCREPANCY_THRESHOLD_PERCENT=10

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: automatically create the first admin user on startup if no
# users exist yet. After the first run you can remove these and manage
# users with `node scripts/manage-users.js`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
